[Unit]
Description=Provision Calyx authorized SSH keys for system users
After=local-fs.target
Before=sshd.service sshd.socket
ConditionPathExists=/usr/share/calyx/keys/authorized_keys

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -c '\
  KEY=$$(cat /usr/share/calyx/keys/authorized_keys 2>/dev/null); \
  [ -z "$$KEY" ] && exit 0; \
  for user in jhuang root; do \
    HOME_DIR=$$(getent passwd "$$user" | cut -d: -f6); \
    if [ -n "$$HOME_DIR" ] && [ -d "$$HOME_DIR" ]; then \
      mkdir -p "$$HOME_DIR/.ssh"; \
      touch "$$HOME_DIR/.ssh/authorized_keys"; \
      if ! grep -q -F "$$KEY" "$$HOME_DIR/.ssh/authorized_keys"; then \
        echo "$$KEY" >> "$$HOME_DIR/.ssh/authorized_keys"; \
      fi; \
      chmod 0700 "$$HOME_DIR/.ssh"; \
      chmod 0600 "$$HOME_DIR/.ssh/authorized_keys"; \
      chown -R "$$user:$$user" "$$HOME_DIR/.ssh" 2>/dev/null || true; \
      restorecon -R "$$HOME_DIR/.ssh" 2>/dev/null || true; \
    fi; \
  done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
